{
  "name": "comdock",
  "version": "2.1.0",
  "private": true,
  "description": "COMDOCK is a web application that allows you to view simulated fake company informations.",
  "homepage": "https://github.com/ncs-northware/comdock",
  "bugs": "https://github.com/ncs-northware/comdock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncs-northware/comdock.git"
  },
  "license": "MIT",
  "author": "NCS Northware (https://github.com/ncs-northware)",
  "contributors": [
    "onissen (https://github.com/onissen)"
  ],
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check": "ultracite check",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port=40090",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "fix": "ultracite fix",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port=40090",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "tsc-check": "tsc --noemit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-import-export": "^3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "^3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.8",
    "graphql": "^17.0.2",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "payload": "3.91.0",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "ultracite": "8.0.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.11.1",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": "^12"
  }
}
